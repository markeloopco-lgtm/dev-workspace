# AITuberKit 環境変数テンプレート（本パイプライン構成: Gemini + Style-Bert-VITS2 + Live2D + YouTube自動応答 + OBS配信）
#
# 使い方: AITuberKit側で `cp .env.example .env` した後、このファイルの値を .env に反映する。
#   scripts/setup_aituber.sh init <dir> を使えば自動で反映される。
# 変数名は aituber-kit本家 .env.example (2026-07-19時点 main) から検証済み。

# ===== AI応答 (Google Gemini) =====
GOOGLE_API_KEY=""
NEXT_PUBLIC_SELECT_AI_SERVICE="google"
NEXT_PUBLIC_SELECT_AI_MODEL="gemini-2.5-flash"

# ===== キャラクター (Live2D) =====
# 注意: Live2D機能はLive2D社とのライセンス合意が前提。AITuberKitの
# Live2D機能は現在「商用利用不可」(非商用はOK)。docs/04参照。
NEXT_PUBLIC_LIVE2D_ENABLED="true"
NEXT_PUBLIC_MODEL_TYPE="live2d"
# 自作モデルのパス: public/live2d/<フォルダ>/<名前>.model3.json に合わせて変更
NEXT_PUBLIC_SELECTED_LIVE2D_PATH="/live2d/mymodel/mymodel.model3.json"

# 感情タグ → モデルの表情名(model3.jsonのExpressions.Name)のマッピング。カンマ区切り
NEXT_PUBLIC_NEUTRAL_EMOTIONS="Neutral"
NEXT_PUBLIC_HAPPY_EMOTIONS="Happy"
NEXT_PUBLIC_SAD_EMOTIONS="Sad"
NEXT_PUBLIC_ANGRY_EMOTIONS="Angry"
NEXT_PUBLIC_RELAXED_EMOTIONS="Relaxed"
NEXT_PUBLIC_SURPRISED_EMOTIONS="Neutral"
# 感情タグ → モーショングループ名(model3.jsonのMotionsのキー)のマッピング
NEXT_PUBLIC_IDLE_MOTION_GROUP="Idle"
NEXT_PUBLIC_NEUTRAL_MOTION_GROUP="Neutral"
NEXT_PUBLIC_HAPPY_MOTION_GROUP="Happy"
NEXT_PUBLIC_SAD_MOTION_GROUP="Sad"
NEXT_PUBLIC_ANGRY_MOTION_GROUP="Angry"
NEXT_PUBLIC_RELAXED_MOTION_GROUP="Relaxed"
NEXT_PUBLIC_SURPRISED_MOTION_GROUP="Neutral"

# ===== 音声合成 (Style-Bert-VITS2 ローカルサーバー) =====
NEXT_PUBLIC_SELECT_VOICE="stylebertvits2"
STYLEBERTVITS2_SERVER_URL="http://127.0.0.1:5000"
NEXT_PUBLIC_STYLEBERTVITS2_MODEL_ID="0"
NEXT_PUBLIC_STYLEBERTVITS2_STYLE="Neutral"
NEXT_PUBLIC_STYLEBERTVITS2_SDP_RATIO="0.2"
NEXT_PUBLIC_STYLEBERTVITS2_LENGTH="1.0"

# ===== YouTube自動応答 =====
NEXT_PUBLIC_YOUTUBE_MODE="true"
# Google CloudでYouTube Data API v3を有効化したAPIキー
NEXT_PUBLIC_YOUTUBE_API_KEY=""
# 配信ごとに変わるライブ配信ID(動画ID)。配信開始時に設定UIから入れてもよい
NEXT_PUBLIC_YOUTUBE_LIVE_ID=""
NEXT_PUBLIC_YOUTUBE_COMMENT_SOURCE="youtube-api"
NEXT_PUBLIC_YOUTUBE_COMMENT_INTERVAL="10"
# 会話継続モード(コメントが無くても自発的に話す)の閾値。モード自体は設定UIでON
NEXT_PUBLIC_CONVERSATION_CONTINUITY_NEW_TOPIC_THRESHOLD="3"
NEXT_PUBLIC_CONVERSATION_CONTINUITY_SLEEP_THRESHOLD="6"

# ===== 配信向け表示 (OBS取り込み) =====
# "green" 指定で背景が単色 #00FF00 になる → OBS側でクロマキー
NEXT_PUBLIC_BACKGROUND_IMAGE_PATH="green"
# 配信画面から設定パネルを消す
NEXT_PUBLIC_SHOW_CONTROL_PANEL="false"
# AIの回答を字幕表示 (bubble: ガラスバブル / borderless: 字幕風)
NEXT_PUBLIC_SHOW_ASSISTANT_TEXT="true"
NEXT_PUBLIC_ASSISTANT_TEXT_STYLE="borderless"
NEXT_PUBLIC_SHOW_CHARACTER_NAME="true"
